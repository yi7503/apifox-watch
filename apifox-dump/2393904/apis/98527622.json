{
  "id": 98527622,
  "name": "发起获取数电版式任务",
  "type": "http",
  "serverId": "",
  "preProcessors": [],
  "postProcessors": [],
  "inheritPreProcessors": {},
  "inheritPostProcessors": {},
  "description": "该接口用于申请数电发票版式文件，可通过该接口批量申请已开具和取得的数电发票 xml、 pdf 、ofd、版式文件和ewm链接",
  "operationId": "",
  "sourceUrl": "",
  "method": "post",
  "path": "/v2/invoice/sdfile/applyLayoutFile",
  "tags": [
    "发票归集"
  ],
  "status": "released",
  "requestBody": {
    "type": "application/json",
    "parameters": [],
    "jsonSchema": {
      "type": "object",
      "properties": {
        "nsrsbh": {
          "type": "string",
          "title": "纳税人识别号"
        },
        "kpyf": {
          "type": "integer",
          "title": "开票月份",
          "description": "日期类型(dateType)不传或为0时必填，格式YYYYMM"
        },
        "kprqq": {
          "type": "string",
          "title": "开票日期起",
          "description": "按日下载，日期类型(dateType)为1时必填，格式YYYYMMdd"
        },
        "kprqz": {
          "type": "string",
          "title": "开票日期止",
          "description": "按日下载，日期类型(dateType)为1时必填，格式YYYYMMdd"
        },
        "dateType": {
          "type": "string",
          "title": "日期类型",
          "description": "根据开票月份/开票日期起止判断此字段传参（不传默认按月）：\n1、如传值为开票月份(kpyf)时，此字段传0-月\n2、如传值为开票日期(kprqq&kprqz)时，此字段传1-天(日期起止不允许跨月，必需是同月份)",
          "enum": [
            "0",
            "1"
          ],
          "x-apifox-enum": [
            {
              "value": "0",
              "name": "月",
              "description": ""
            },
            {
              "value": "1",
              "name": "天",
              "description": ""
            }
          ]
        },
        "jxxbzs": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "jx",
              "xx"
            ],
            "x-apifox-enum": [
              {
                "value": "jx",
                "name": "进项",
                "description": ""
              },
              {
                "value": "xx",
                "name": "销项",
                "description": ""
              }
            ]
          },
          "title": "进销项标志",
          "description": "不传默认全部"
        },
        "fplxs": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "51-数电票(铁路电子客票)",
              "61-数电票(航空运输电子客票行程单)",
              "70-数电票(二手车销售统一发票)",
              "81-数电专票",
              "82-数电普票",
              "83-数电票(机动车销售统一发票)",
              "8208-数电票（通行费发票）"
            ],
            "x-apifox-enum": [
              {
                "value": "51-数电票(铁路电子客票)",
                "name": "",
                "description": ""
              },
              {
