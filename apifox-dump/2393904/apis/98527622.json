                "name": "",
                "description": ""
              },
              {
                "value": "70-数电票(二手车销售统一发票)",
                "name": "",
                "description": ""
              },
              {
                "value": "81-数电专票",
                "name": "",
                "description": ""
              },
              {
                "value": "82-数电普票",
                "name": "",
                "description": ""
              },
              {
                "value": "83-数电票(机动车销售统一发票)",
                "name": "",
                "description": ""
              },
              {
                "value": "8208-数电票（通行费发票）",
                "name": "",
                "description": ""
              }
            ]
          },
          "title": "发票类型",
          "description": "不传默认全部"
        },
        "addJob": {
          "type": "boolean",
          "title": "发起任务类型",
          "description": "true-发起获取版式任务；false-获取版式任务结果\n此字段用于发起任务及任务结果查询：\n1、传true发起任务\n2、传false获取任务结果，返回成功则调用「获取数电票版式文件」获取版式文件"
        }
      },
      "required": [
