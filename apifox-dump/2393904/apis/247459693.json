        "qymc",
        "mmlx",
        "smzh",
        "smmm",
        "sbmm",
        "djxhid",
        "areaid",
        "bmbh",
        "bmmc"
      ],
      "required": [
        "aggOrgId",
        "qymc",
        "mmlx",
        "nsrsbh",
        "areaid"
      ]
    },
    "required": false,
    "mediaType": "",
