          "title": "维护企业信息接口返回的 aggOrgId"
        },
        "accountId": {
          "type": "string",
          "title": "账号ID"
        },
        "skssqq": {
          "type": "string",
          "description": "首年税款所属期起应在企业开业设立日期所在月份， 次年及之后应为每年1月,税款所属期起，格式：YYYYMMDD",
          "title": "税款所属期起"
        },
        "skssqz": {
          "type": "string",
          "title": "税款所属期止",
          "description": "税款所属期止，格式：YYYYMMDD"
        },
        "tzzlb": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
