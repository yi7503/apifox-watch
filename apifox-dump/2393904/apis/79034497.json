    "value": "var requestJsonData = $$.mockRequest.body.toJSON();\r\nvar ywlx = requestJsonData['ywlx'];\r\n// 1-申请统计； 2-撤销统计 ；3-申请确认； 7-退税确认(退税);\r\n// 获取系统自动生成的 JSON 格式响应数据\r\nvar responseJsonData = $$.mockResponse.json();\r\n// 申请统计\r\n    // 设置接口返回 JSON 格式 Body\r\nif (ywlx == \"1\") {\r\n    $$.mockResponse.setBody({\r\n        \"data\": 459948965835072\r\n    });\r\n}\r\n// 撤销统计\r\nif(ywlx == \"2\"){\r\n    $$.mockResponse.setBody({\r\n        \"data\": 459948965835073\r\n    });\r\n}\r\n// 申请确认\r\nif(ywlx == \"3\"){\r\n    $$.mockResponse.setBody({\r\n        \"data\": 459948965835074\r\n    });\r\n}"
