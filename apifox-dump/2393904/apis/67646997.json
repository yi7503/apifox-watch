{
  "id": 67646997,
  "name": "发起下载往期PDF任务",
  "type": "http",
  "serverId": "",
  "preProcessors": [],
  "postProcessors": [],
  "inheritPreProcessors": {},
  "inheritPostProcessors": {},
  "description": "## 接口描述\n根据税费种的yzpzzlDm和税款所属期发起从税局获取往期PDF文件及结构化数据进行归档。支持单税种下载。 \n该功能只支持查询2021年及之后的数据。 \n下载PDF任务执行完后，可以通过【查询往期pdf数据】接口进行查询，节点pdfUrl获取文件地址。\n\n2026年7月最新变化：此接口可以不进行对接，直接通过原获取当期PDF接口即可下载。https://openapi.qixiangyun.com/api-67645165\n\n\n## 错误码\n\n| **错误代码** | **错误信息**  | **解决方案**|\n| --- | --- |---|\n| PARAMETER_ERROR | 没有找到对应的企业！ |\n| BUSINESS_ERROR | 任务不支持 |\n| PARAMETER_ERROR | 企业Id(aggOrgId)不能为空! |\n| INTERFACE_ERROR | 接口异常,请联系管理员!|\n| INTERFACE_ERROR | 系统繁忙，请降低调用频率！|",
  "operationId": "",
  "sourceUrl": "",
  "method": "post",
  "path": "/v2/tax/qys/loadWqPdfTask",
  "tags": [],
  "status": "released",
  "requestBody": {
    "type": "application/json",
    "parameters": [],
    "jsonSchema": {
      "x-apifox-overrides": {},
      "type": "object",
      "x-apifox-refs": {},
      "x-apifox-orders": [
        "aggOrgId",
        "accountId",
        "tdztswjgmc",
        "skssqq",
        "skssqz",
        "sbrqq",
        "sbrqz",
        "projectType",
        "analysisPdf",
        "yzpzzlDms",
        "bsswjg",
        "kqyswjgmc"
      ],
      "properties": {
        "aggOrgId": {
          "type": "string",
          "title": "企业Id"
        },
        "skssqq": {
          "type": "string",
          "description": "格式为yyyy-MM-dd",
          "title": "税款所属期起"
        },
        "skssqz": {
          "type": "string",
          "description": "格式为yyyy-MM-dd",
          "title": "税款所属期止"
        },
        "sbrqq": {
          "type": "string",
          "title": "申报日期起",
          "description": "格式为yyyy-MM-dd ； 对于往年申报的税种比如25年，申报日期必填，可以传25年1月1日  - 25年12月31日"
        },
        "sbrqz": {
          "type": "string",
          "description": "格式为yyyy-MM-dd ；； 对于往年申报的税种比如25年，申报日期必填，可以传25年1月1日  - 25年12月31日",
          "title": "申报日期止"
        },
        "projectType": {
          "type": "integer",
          "description": "0为税务 1为财报",
          "title": "查询的是财报还是税务"
        },
        "yzpzzlDms": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "参考申报附录应征凭证种类代码（只支持单个税种发起下载）",
          "title": "各税种的yzpzzlDm列表"
        },
        "analysisPdf": {
          "type": [
            "string",
            "null"
          ],
          "title": "解析pdf",
          "description": "解析pdf Y-解析 N-不解析；支持解析税种：增值税小规模 、增值税一般人、企业所得税预缴（月季报）、财务报表月季报/年报、印花税、房产税、土地、房土合并（财行税21年6月实行之前的报表不支持解析）、通用申报、残疾人保障金、文化事业建设费、金融类财务报表、汇算清缴（2025年前报表不支持解析）"
        },
        "accountId": {
          "type": "string",
          "description": "账号ID（多账号场景使用）",
          "title": "账号ID"
        },
        "bsswjg": {
          "type": "string",
          "description": "（上传格式 省|市|区 如“湖南省|湘潭市|岳塘区”）",
          "title": "跨区域上传税务机关名称"
        },
        "tdztswjgmc": {
          "type": "string",
          "title": "特定主体税务机关名称"
        },
        "kqyswjgmc": {
          "type": "string",
          "title": "跨区域税局机关名称"
        }
      },
      "required": [
        "aggOrgId",
        "projectType",
        "skssqq",
        "skssqz",
        "yzpzzlDms"
      ]
    },
    "required": false,
    "mediaType": "",
    "examples": [
      {
        "value": "{\r\n    \"aggOrgId\":452681066557441,\r\n    \"skssqq\": \"2023-02-01\",\r\n    \"skssqz\": \"2023-02-28\",\r\n    \"sbrqq\": \"2023-03-01\",\r\n    \"sbrqz\": \"2023-03-31\",\r\n    \"projectType\":0,\r\n    \"analysisPdf\": \"Y\",\r\n    \"yzpzzlDms\": [\r\n        \"BDA0610606\"\r\n    ]\r\n}",
