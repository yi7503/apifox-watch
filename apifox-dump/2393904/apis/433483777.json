      "description": "定义了所需字段的结构和约束",
      "properties": {
        "aggOrgId": {
          "type": "string",
          "description": "企业ID"
        },
        "accountId": {
          "type": "string",
          "description": "账号ID"
        },
        "kpyq": {
          "type": "string",
          "description": "开票月起，格式YYYYMM",
          "pattern": "^\\d{6}$",
          "examples": [
            "202401"
          ]
        },
        "kpyz": {
          "type": "string",
          "description": "开票月止，格式YYYYMM，与开票月起不能超过12个月",
          "pattern": "^\\d{6}$",
          "examples": [
            "202412"
          ]
        }
      },
