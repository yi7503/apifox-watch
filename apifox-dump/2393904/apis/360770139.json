      "properties": {
        "aggOrgId": {
          "type": "string",
          "title": "企业ID",
          "description": " ",
          "minLength": 1,
          "examples": [
            "ORG2024050100001",
            "AGG-SH-00123456"
          ]
        },
        "accountId": {
          "type": "string",
          "title": "账号ID",
          "description": " ",
          "minLength": 1,
          "examples": [
            "ACC8880001",
            "USER-20240520001"
          ]
        },
        "dwbh": {
          "type": "string",
          "title": "单位编号",
          "description": " ",
          "minLength": 1,
          "examples": [
            "DWS20240001",
            "UNIT-BJ-0005"
          ]
        },
        "fkssq": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "title": "费款所属期列表",
          "description": " 1.固定格式为“YYYYMM”（4位年份+2位月份），不可为空\n2.支持多费款所属期数据批量提交\n3.注意，上海地区单次只能申报一个所属期社保费"
        },
        "dwzyjfy": {
          "type": "number",
          "title": "单位总应缴费额合计",
          "description": "若传输，则校验待申报时的应缴费额和申报提交时应缴费用是否一致\n",
          "minimum": 0,
          "multipleOf": 0.01,
          "examples": [
            12500.5,
            8900,
            5678.25
          ]
        }
      },
      "required": [
        "aggOrgId",
        "accountId",
        "fkssq"
      ],
