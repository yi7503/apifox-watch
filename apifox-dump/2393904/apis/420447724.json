      "properties": {
        "aggOrgId": {
          "type": "string",
          "description": "企业ID"
        },
        "accountId": {
          "type": "string",
          "description": "账户ID"
        },
        "ssfxtxhf": {
          "type": "object",
          "description": "申诉风险提醒回复内容",
