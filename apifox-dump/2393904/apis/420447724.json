            "xxxh",
            "fxmxxh",
            "pcxh",
            "ssrdah",
            "fksm",
            "fkrxm",
            "fkrlxfs"
          ],
          "properties": {
            "xxxh": {
              "type": "string",
              "description": "消息id",
              "minLength": 1
            },
            "fxmxxh": {
              "type": "string",
              "description": "风险明细序号",
              "minLength": 1
            },
            "pcxh": {
              "type": "string",
              "description": "批次序号",
              "minLength": 1
            },
            "ssrdah": {
              "type": "string",
              "description": "申诉人档案号",
              "minLength": 1
            },
            "zccljg": {
              "type": "boolean",
              "description": "自查处理结果。是：申诉属实；否：申诉不属实"
            },
            "fksm": {
              "type": "string",
              "description": "反馈说明",
              "minLength": 1,
              "maxLength": 1000
            },
            "fkrxm": {
              "type": "string",
              "description": "反馈人姓名",
              "minLength": 1
            },
            "fkrlxfs": {
              "type": "string",
              "description": "反馈人联系电话",
              "minLength": 1
            },
            "wjlb": {
              "type": "array",
              "description": "文件列表",
              "items": {
                "type": "object",
                "required": [
                  "wjbm",
                  "wjmc"
                ],
                "properties": {
                  "wjbm": {
                    "type": "string",
                    "description": "base64编码",
                    "minLength": 1
                  },
                  "wjmc": {
                    "type": "string",
                    "description": "文件名称（需带文件后缀，格式限制JPG, JPEG, BMP, PNG）",
                    "minLength": 1,
                    "pattern": "^.*\\.(jpg|jpeg|bmp|png)$"
                  }
                },
                "x-apifox-orders": [
                  "wjbm",
                  "wjmc"
                ]
              }
            },
            "ssmxlb": {
              "type": "array",
              "description": "申诉明细列表",
              "items": {
                "type": "object",
                "properties": {
                  "mxxh": {
                    "type": "string",
                    "description": "明细序号（条件必填）"
                  },
                  "sf": {
                    "type": "boolean",
                    "description": "是否存在标志。true:存在; false:不存在"
                  }
                },
                "x-apifox-orders": [
                  "mxxh",
                  "sf"
                ],
                "required": [
                  "mxxh"
                ]
              }
            }
          },
          "x-apifox-orders": [
            "xxxh",
            "fxmxxh",
