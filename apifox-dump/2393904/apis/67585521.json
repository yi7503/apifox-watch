{
  "id": 67585521,
  "name": "上传财报数据",
  "type": "http",
  "serverId": "",
  "preProcessors": [],
  "postProcessors": [],
  "inheritPreProcessors": {},
  "inheritPostProcessors": {},
  "description": "## 接口描述\n上传财报信息（每次只能上传一个税种）。\n\n## 错误码\n\n| **错误代码** | **错误信息**  | **解决方案**|\n| --- | --- |---|\n| PARAMETER_ERROR | 企业Id(aggOrgId)不能为空! |\n| PARAMETER_ERROR | 申报年不能为空！ |\n| PARAMETER_ERROR | 申报月不能为空！ |\n| PARAMETER_ERROR | 请求参数year或period不合法！ |\n| PARAMETER_ERROR | 请求参数duration不能小于30 |\n| PARAMETERCheck | 请求参数isDirectDeclare=true和exAction=1参数非法！ |\n| PARAMETERCheck | 【cbData】或者【cbnbData】必传不能为空 |\n| PARAMETERCheck | 上传报文，校验异常，请联系管理员！ |\n| PARAMETERCheck | 上传报文，参数校验失败，请检查！ |\n| PARAMETERCheck | 上传报文，业务校验失败，请检查！|\n| BUSINESS_ERROR | 任务不支持待上线 |\n| PARAMETERCheck | 参数业务校验异常 |\n| INTERFACE_ERROR | 接口异常,请联系管理员!|\n| INTERFACE_ERROR | 系统繁忙，请降低调用频率！|\n",
  "operationId": "",
  "sourceUrl": "",
  "method": "post",
  "path": "/v2/tax/qys/writeFiData",
  "tags": [],
  "status": "released",
  "requestBody": {
    "type": "application/json",
    "parameters": [],
    "jsonSchema": {
      "type": "object",
      "x-apifox-refs": {},
      "x-apifox-orders": [
        "aggOrgId",
        "accountId",
        "year",
        "period",
        "duration",
        "exAction",
        "isDirectDeclare",
        "jrwc",
        "gzDeclare",
        "overloadKjzdzz",
        "waitResult",
        "sfjxbdjy",
        "attachName",
        "attachEncode",
        "cbData",
        "jthbData",
        "cbnbData",
        "optionCodeList"
      ],
      "properties": {
        "aggOrgId": {
          "type": "string",
          "title": "企业Id",
          "description": "创建企业返回的 id"
        },
        "year": {
          "type": "integer",
          "description": " 格式yyyy",
          "title": "申报年份"
        },
        "period": {
          "type": "integer",
          "description": "自然月（1-12）",
          "title": "申报月份 "
        },
        "exAction": {
          "type": [
            "integer",
            "null"
          ],
          "description": "新版税局不支持此能力，即将下线。0 上传不发起税局暂存任务；1 上传发起税局暂存任务 ",
          "title": "发起税局暂存任务"
        },
        "isDirectDeclare": {
          "type": [
            "boolean",
            "null"
          ],
          "title": "是否上传数据直接申报",
          "description": "默认false"
        },
        "gzDeclare": {
          "type": [
            "integer",
            "null"
          ],
          "title": "财报覆盖申报",
          "description": "1表示覆盖申报；0表示不覆盖。默认及空为0； 当isDirectDeclare为true 时生效。此参数针对税局财报已申报，是否继续覆盖申报\t"
        },
        "overloadKjzdzz": {
          "type": [
            "boolean",
            "null"
          ],
          "title": "是否重置会计制度准则",
          "description": "传入true，重置清册和企业信息的财报备案设置，以上传报文的准则为准"
        },
        "cbData": {
          "type": [
            "object",
            "null"
          ],
          "properties": {},
          "description": "当上传月季度报文时，该字段不允许为空，报文结构参考申报附录中的报文结构相应报文",
          "x-apifox-orders": [],
          "title": "财报月季度报文"
        },
        "cbnbData": {
          "type": [
            "object",
            "null"
          ],
          "properties": {},
          "description": "上传财报年报时，该字段不为空，报文结构参考申报附录中的报文结构相应报文",
          "x-apifox-orders": [],
          "title": "财报年度申报报文"
        },
        "optionCodeList": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object",
            "properties": {
              "optionCode": {
                "type": [
                  "string",
                  "null"
                ],
                "title": "选项code"
              },
              "memoJson": {
                "type": [
                  "string",
                  "null"
                ],
                "title": "备注信息"
              },
              "fileCode": {
                "type": "string",
                "title": "文件编码",
                "description": "base64加密后的串，非必传。只有optionCode为强制申报使用"
              },
              "fileName": {
                "type": "string",
                "title": "文件名称"
              }
            },
            "x-apifox-orders": [
              "optionCode",
              "memoJson",
              "fileCode",
              "fileName"
            ],
            "required": [
              "fileCode",
              "fileName"
            ]
          },
          "title": "多条弹窗设置明细"
        },
        "duration": {
          "type": [
            "integer",
            "null"
          ],
          "title": "任务时长",
          "description": "（必须大于30），单位分钟"
        },
        "attachName": {
          "type": [
            "string",
            "null"
          ],
          "title": "财报附注excel文件名称",
          "description": "财报附注使用，即将下线新版税局不支持"
        },
        "attachEncode": {
          "type": [
            "string",
            "null"
          ],
          "title": "财报附注excelbase64加密后的串，必传；EXCEL模板",
          "description": "财报附注使用，即将下线新版税局不支持"
        },
        "waitResult": {
          "type": [
            "boolean",
            "null"
          ],
          "title": "是否等待结果",
          "description": "（仅针对浙江、云南、海南地区）\t即将下线，新版税局无此功能"
        },
        "jthbData": {
          "type": [
            "object",
            "null"
          ],
          "properties": {},
          "title": "企业集团合并财务报表",
          "description": "JSON格式，报文结构参考申报附录中的报文结构相应报文",
          "x-apifox-orders": []
        },
        "jrwc": {
          "type": "string",
          "title": "是否兼容一分钱尾差",
          "description": "Y兼容，N不兼容。默认不兼容。"
        },
        "accountId": {
          "type": "string",
          "title": "账号ID",
          "description": "多账号场景"
        },
        "sfjxbdjy": {
          "type": [
            "string",
            "null"
          ],
          "title": "是否进行表单校验",
          "description": "财报专用，Y=是/N=否 ；备注：非必传字段，请求Y则会对请求的表单节点与税局报表列表进行比对是否一致，税局要求申报的表单未请求则失败返回。默认传空，或者传N则是维持现状只校验必填表单（资产、利润），其他表单不上传默认以税局带出申报"
        }
      },
      "required": [
        "aggOrgId",
        "year",
        "period"
      ]
    },
    "required": false,
    "mediaType": "",
    "examples": [
