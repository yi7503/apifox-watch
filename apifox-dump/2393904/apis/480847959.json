      "data": "\r\n#### 1 申报缴款记录（`sbjklb` 元素）\r\n\r\n| 字段 | 类型 | 说明 |\r\n|---|---|---|\r\n| `sblsh` | string | 申报流水号 |\r\n| `yjfehj` | number | 应缴费额 |\r\n| `yijfehj` | number | 已缴费额合计 |\r\n| `fkssqq` | string | 费款所属期起 YYYYMM |\r\n| `fkssqz` | string | 费款所属期止 YYYYMM |\r\n| `sbrq` | string | 申报日期 YYYY-MM-DD |\r\n| `sbfs` | string | 申报方式，返回中文 |\r\n| `sbhzb` | list | 申报汇总表，元素字段见 2 |\r\n| `sbmx` | list | 申报明细表，元素字段见 3 |\r\n| `jkqk` | list | 缴款情况，元素字段见 4 |\r\n\r\n#### 2 申报汇总表（`sbhzb` 元素）\r\n\r\n| 字段 | 类型 | 说明 |\r\n|---|---|---|\r\n| `fkssqq` | string | 费款所属期起 YYYYMM |\r\n| `fkssqz` | string | 费款所属期止 YYYYMM |\r\n| `zsxm` | string | 征收项目，返回中文 |\r\n| `zspm` | string | 征收品目，返回中文 |\r\n| `jfrs` | number | 缴费人数 |\r\n| `jfjsze` | number | 缴费基数总额 |\r\n| `fl` | number | 费率 |\r\n| `yjje` | number | 应缴金额 |\r\n| `jfjsdwhj` | number | 缴费基数总额-单位合计 |\r\n| `jfjsgrhj` | number | 缴费基数总额-个人合计 |\r\n| `jfjshj` | number | 缴费基数总额-总计 |\r\n| `yjjedwhj` | number | 应缴金额-单位合计 |\r\n| `yjjegrhj` | number | 应缴金额-个人合计 |\r\n| `yjjehj` | number | 应缴金额-总计 |\r\n\r\n#### 3 申报明细表（`sbmx` 元素）\r\n\r\n| 字段 | 类型 | 说明 |\r\n|---|---|---|\r\n| `xm` | string | 姓名 |\r\n| `zjlx` | string | 证件类型，返回中文 |\r\n| `zjhm` | string | 证件号码 |\r\n| `grsbh` | string | 个人社保号 |\r\n| `fkssqq` | string | 费款所属期起 YYYYMM |\r\n| `fkssqz` | string | 费款所属期止 YYYYMM |\r\n| `jbyljfjsdw` | number | 基本养老保险缴费基数-单位 |\r\n| `jbylyjjedw` | number | 基本养老保险应缴金额-单位 |\r\n| `jbyljfjsgr` | number | 基本养老保险缴费基数-个人 |\r\n| `jbylyjjegr` | number | 基本养老保险应缴金额-个人 |\r\n| `syjfjsdw` | number | 失业保险缴费基数-单位 |\r\n| `syyjjedw` | number | 失业保险应缴金额-单位 |\r\n| `syjfjsgr` | number | 失业保险缴费基数-个人 |\r\n| `syyjjegr` | number | 失业保险应缴金额-个人 |\r\n| `jbyiliaojfjsdw` | number | 基本医疗保险缴费基数-单位 |\r\n| `jbyiliaoyjjedw` | number | 基本医疗保险应缴金额-单位 |\r\n| `jbyiliaojfjsgr` | number | 基本医疗保险缴费基数-个人 |\r\n| `jbyiliaoyjjegr` | number | 基本医疗保险应缴金额-个人 |\r\n| `gsjfjs` | number | 工伤保险缴费基数 |\r\n| `gsyjje` | number | 工伤保险应缴金额 |\r\n| `gebcyljfjs` | number | 高额补充医疗保险缴费基数-单位 |\r\n| `gebcylyjje` | number | 高额补充医疗保险应缴金额-单位 |\r\n| `tdrydxgsjfjs` | number | 特定人员单项工伤保险缴费基数 |\r\n| `drydxgsyjje` | number | 特定人员单项工伤保险应缴金额 |\r\n| `bcjbyiliaojfjsdw` | number | 补充基本医疗保险缴费基数-单位 |\r\n| `bcjbyiliaoyjjedw` | number | 补充基本医疗保险应缴金额-单位 |\r\n| `bcjbyiliaojfjsgr` | number | 补充基本医疗保险缴费基数-个人 |\r\n| `bcjbyiliaoyjjegr` | number | 补充基本医疗保险应缴金额-个人 |\r\n| `xxxxjfjs` | number | xxx险种缴费基数 |\r\n| `xxxxyjje` | number | xxx险种应缴金额 |\r\n| `dwbfhj` | number | 单位部分合计 |\r\n| `grbfhj` | number | 个人部分合计 |\r\n| `yjjehj` | number | 应缴金额合计 |\r\n\r\n\r\n#### 4 缴款情况（`jkqk` 元素）\r\n\r\n| 字段 | 类型 | 说明 |\r\n|---|---|---|\r\n| `sblsh` | string | 申报流水号 |\r\n| `zsxm` | string | 征收项目，返回中文 |\r\n| `zspm` | string | 征收品目，返回中文 |\r\n| `fkssqq` | string | 费款所属期起 YYYYMM |\r\n| `fkssqz` | string | 费款所属期止 YYYYMM |\r\n| `yjkzje` | number | 应缴款总金额 |\r\n| `yijkzje` | number | 已缴款总金额 |\r\n| `jkrq` | string | 缴款日期 |\r\n| `jkqx` | string | 缴款期限 |\r\n| `yjkzjehj` | number | 应缴款总金额合计 |\r\n| `yijkzjehj` | number | 已缴款总金额合计 |\r\n\r\n#### 5 字段示例\r\n\r\n```json\r\n{\r\n    \"sbjklb\": [\r\n        {\r\n            \"sblsh\": \"SB2025010001\",\r\n            \"yjfehj\": 28380.00,\r\n            \"yijfehj\": 28380.00,\r\n            \"fkssqq\": \"202501\",\r\n            \"fkssqz\": \"202506\",\r\n            \"sbrq\": \"2025-07-10\",\r\n            \"sbfs\": \"网上申报\",\r\n            \"sbhzb\": [\r\n                {\r\n                    \"fkssqq\": \"202501\",\r\n                    \"fkssqz\": \"202506\",\r\n                    \"zsxm\": \"基本养老保险\",\r\n                    \"zspm\": \"基本养老保险费\",\r\n                    \"jfrs\": 2,\r\n                    \"jfjsze\": 60000.00,\r\n                    \"fl\": 0.24,\r\n                    \"yjje\": 19200.00,\r\n                    \"jfjsdwhj\": 60000.00,\r\n                    \"jfjsgrhj\": 60000.00,\r\n                    \"jfjshj\": 120000.00,\r\n                    \"yjjedwhj\": 9600.00,\r\n                    \"yjjegrhj\": 9600.00,\r\n                    \"yjjehj\": 19200.00\r\n                },\r\n                {\r\n                    \"fkssqq\": \"202501\",\r\n                    \"fkssqz\": \"202506\",\r\n                    \"zsxm\": \"基本医疗保险\",\r\n                    \"zspm\": \"基本医疗保险费\",\r\n                    \"jfrs\": 2,\r\n                    \"jfjsze\": 60000.00,\r\n                    \"fl\": 0.13,\r\n                    \"yjje\": 7800.00,\r\n                    \"jfjsdwhj\": 60000.00,\r\n                    \"jfjsgrhj\": 60000.00,\r\n                    \"jfjshj\": 120000.00,\r\n                    \"yjjedwhj\": 6000.00,\r\n                    \"yjjegrhj\": 1800.00,\r\n                    \"yjjehj\": 7800.00\r\n                }\r\n            ],\r\n            \"sbmx\": [\r\n                {\r\n                    \"xm\": \"张三\",\r\n                    \"zjlx\": \"居民身份证\",\r\n                    \"zjhm\": \"110101199001011234\",\r\n                    \"grsbh\": \"GRSB0001\",\r\n                    \"fkssqq\": \"202501\",\r\n                    \"fkssqz\": \"202506\",\r\n                    \"jbyljfjsdw\": 30000.00,\r\n                    \"jbylyjjedw\": 4800.00,\r\n                    \"jbyljfjsgr\": 30000.00,\r\n                    \"jbylyjjegr\": 4800.00,\r\n                    \"syjfjsdw\": 30000.00,\r\n                    \"syyjjedw\": 300.00,\r\n                    \"syjfjsgr\": 30000.00,\r\n                    \"syyjjegr\": 150.00,\r\n                    \"jbyiliaojfjsdw\": 30000.00,\r\n                    \"jbyiliaoyjjedw\": 3000.00,\r\n                    \"jbyiliaojfjsgr\": 30000.00,\r\n                    \"jbyiliaoyjjegr\": 900.00,\r\n                    \"gsjfjs\": 30000.00,\r\n                    \"gsyjje\": 240.00,\r\n                    \"gebcyljfjs\": 0.00,\r\n                    \"gebcylyjje\": 0.00,\r\n                    \"tdrydxgsjfjs\": 0.00,\r\n                    \"drydxgsyjje\": 0.00,\r\n                    \"bcjbyiliaojfjsdw\": 0.00,\r\n                    \"bcjbyiliaoyjjedw\": 0.00,\r\n                    \"bcjbyiliaojfjsgr\": 0.00,\r\n                    \"bcjbyiliaoyjjegr\": 0.00,\r\n                    \"dwbfhj\": 8340.00,\r\n                    \"grbfhj\": 5850.00,\r\n                    \"yjjehj\": 14190.00\r\n                },\r\n                {\r\n                    \"xm\": \"李四\",\r\n                    \"zjlx\": \"居民身份证\",\r\n                    \"zjhm\": \"110101199203033456\",\r\n                    \"grsbh\": \"GRSB0002\",\r\n                    \"fkssqq\": \"202501\",\r\n                    \"fkssqz\": \"202506\",\r\n                    \"jbyljfjsdw\": 30000.00,\r\n                    \"jbylyjjedw\": 4800.00,\r\n                    \"jbyljfjsgr\": 30000.00,\r\n                    \"jbylyjjegr\": 4800.00,\r\n                    \"syjfjsdw\": 30000.00,\r\n                    \"syyjjedw\": 300.00,\r\n                    \"syjfjsgr\": 30000.00,\r\n                    \"syyjjegr\": 150.00,\r\n                    \"jbyiliaojfjsdw\": 30000.00,\r\n                    \"jbyiliaoyjjedw\": 3000.00,\r\n                    \"jbyiliaojfjsgr\": 30000.00,\r\n                    \"jbyiliaoyjjegr\": 900.00,\r\n                    \"gsjfjs\": 30000.00,\r\n                    \"gsyjje\": 240.00,\r\n                    \"gebcyljfjs\": 0.00,\r\n                    \"gebcylyjje\": 0.00,\r\n                    \"tdrydxgsjfjs\": 0.00,\r\n                    \"drydxgsyjje\": 0.00,\r\n                    \"bcjbyiliaojfjsdw\": 0.00,\r\n                    \"bcjbyiliaoyjjedw\": 0.00,\r\n                    \"bcjbyiliaojfjsgr\": 0.00,\r\n                    \"bcjbyiliaoyjjegr\": 0.00,\r\n                    \"dwbfhj\": 8340.00,\r\n                    \"grbfhj\": 5850.00,\r\n                    \"yjjehj\": 14190.00\r\n                }\r\n            ],\r\n            \"jkqk\": [\r\n                {\r\n                    \"sblsh\": \"SB2025010001\",\r\n                    \"zsxm\": \"基本养老保险\",\r\n                    \"zspm\": \"基本养老保险费\",\r\n                    \"fkssqq\": \"2025