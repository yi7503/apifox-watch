  "description": "## 接口描述\n该接口是同步接口。\n清除已填写数据，以便用最新申报表数据进行申报\n\n## 错误码\n\n| **错误代码** | **错误信息**\t | **解决方案**|\n| --- | --- | --- |\n| 4003 | 没有找到对应的企业！ |\n| 4002 | aggOrgId请求参数不能为空！ |",
  "operationId": "",
  "sourceUrl": "",
  "method": "post",
  "path": "/v2/iit/calculateTax/batchClearSalaryData",
  "tags": [],
  "status": "released",
  "requestBody": {
    "type": "application/json",
    "parameters": [],
    "jsonSchema": {
      "type": "object",
      "properties": {
        "aggOrgId": {
          "type": "string",
          "title": "维护企业信息接口返回的 aggOrgId"
        },
        "skssq": {
          "type": "string",
          "title": "skssq",
          "description": "格式YYYYMM年月"
        },
        "accountId": {
          "type": "string",
          "title": "账户ID"
        },
        "qktj": {
          "type": "object",
          "properties": {
            "pch": {
              "type": "number",
              "title": "批次号",
              "description": "当sfdpc为1时必填"
            },
            "rylb": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "zzlx": {
                    "type": "string",
                    "title": "证件类型"
                  },
                  "zzhm": {
                    "type": "string",
                    "title": "证件号码"
                  },
                  "xm": {
                    "type": "string",
                    "title": "姓名"
                  }
                },
                "x-apifox-orders": [
                  "zzlx",
                  "zzhm",
                  "xm"
                ],
                "required": [
                  "xm",
                  "zzhm",
                  "zzlx"
                ]
              },
              "title": "人员列表",
              "description": "如果rylb为空，则结合批次号、算薪类型字段清空所有人员的薪金数据；如果rylb传了数据，则结合批次号、算薪类型字段清空rylb对应的数据"
            },
            "sxlx": {
              "type": "string",
              "title": "所得项目",
              "description": "如果sxlx为空，则结合批次号、人员列表字段清空所有人员的薪金数据；如果sxlx传了数据，则结合批次号、人员列表字段清空sxlx对应的数据；枚举见个税附录所得项目，传所得项目代码"
            },
            "sfdpc": {
              "type": "string",
              "title": "是否多批次",
              "description": "0：非多批次\n1：多批次"
            }
          },
          "x-apifox-orders": [
            "sfdpc",
            "pch",
            "rylb",
            "sxlx"
          ],
          "title": "清空数据条件",
          "required": [
            "sfdpc"
          ]
        }
      },
      "required": [
        "aggOrgId",
        "skssq",
        "accountId",
        "qktj"
      ],
      "x-apifox-orders": [
        "aggOrgId",
        "accountId",
        "skssq",
        "qktj"
      ]
    },
    "required": false,
    "mediaType": "",
