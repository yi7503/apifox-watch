    "jsonSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "title": "字段信息JSON Schema",
      "description": "定义了所需字段的结构和约束",
      "properties": {
        "aggOrgId": {
          "type": "string",
          "description": "企业ID"
        },
        "accountId": {
          "type": "string",
          "description": "账号ID，多账户场景"
        },
        "fkssqq": {
          "type": "string",
          "title": "费款所属期起",
          "description": "1.格式：YYYYMM"
        },
        "fkssqz": {
          "type": "string",
          "title": "费款所属期止",
          "description": "1.格式：YYYYMM\n2.费款所属期止必须大于或等于费款所属期起"
        },
        "sblsh": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "1.若上传则校验费款所属期下是否存在流水号，不存在返回：费款所属期起-费款所属期止，不存在该申报流水号\n2.若上传流水号，且流水号正确存在，则只缴款该流水号的申报金额。\n3.若不上传流水号，则缴款费款所属期起-费款所属期止所有欠费数据",
          "title": "申报流水号"
        },
        "sfxyh": {
          "type": "string",
          "description": "存在多个三方协议号时必填",
          "title": "三方协议号"
        }
      },
      "required": [
        "aggOrgId",
        "fkssqq",
        "fkssqz",
        "accountId"
      ],
