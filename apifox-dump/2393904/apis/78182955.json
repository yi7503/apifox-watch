{
  "id": 78182955,
  "name": "上传各税种申报表EXCEL数据",
  "type": "http",
  "serverId": "",
  "preProcessors": [],
  "postProcessors": [],
  "inheritPreProcessors": {},
  "inheritPostProcessors": {},
  "description": "## 接口描述\n上传各税种整表的EXCEL数据（每次只能上传一个税种），需要整表数据。\n目前支持以下excel上传：\nBDA0610606增值税及附加税(适用于一般纳税人)\nBDA0610611增值税及附加税(适用于小规模纳税人)\nBDA0000000财产行为税合并纳税申报（房土）\nBDA0610005车船税\nBDA0610036资源税\nBDA0610100通用申报\nBDA0610334文化事业建设费\nBDA0610334HB  文化使用建设费合并申报\nBDA0610794印花税\nBDA0610980环境保护税纳税申报表\nBDA0610987水资源税\nBDA0611054非税收入通用申报表\nBDA0611111消费税及附加税费申报表\nBDA0611159企业所得税A类\nBDA0610790SYCJ城镇土地使用税税源采集\nBDA0610791SYCJ房产税税源采集\nCWBBSB财务报表申报（月季报）：小企业、企业会计准则未执行/已执行、企业会计制度、金融类企业会计准则已执行\nCWBBNDSB财务报表年度申报（年报）：小企业、企业会计准则未执行/已执行、企业会计制度、金融类企业会计准则已执行\nBDA0610865增值税预缴\nBDA0610857 残保金\nZDSY 重点税源\nBDA0610791房产税\nBDA0610790城镇土地使用税\n## 错误码\n\n| **错误代码** | **错误信息**  | **解决方案**|\n| --- | --- |---|\n| PARAMETER_ERROR | 请求参数不能为空! |\n| PARAMETER_ERROR | 企业Id(aggOrgId)不能为空! |\n| PARAMETER_ERROR | 请求参数zsxmList不能为空！ |\n| PARAMETER_ERROR | 请求参数year或period不能为空！ |\n| BUSINESS_ERROR | 增值税主表错误，请检查数据！ |确认主表sheet页存在且名称“主表”\n| INTERFACE_ERROR | 接口异常,请联系管理员 |\n| INTERFACE_ERROR | 系统繁忙，请降低调用频率！|\n| BUSINESS_ERROR|预约扣款情况，预约扣款日期必填并且是yyyy-MM-dd格式，当前错误值：XXX |",
  "operationId": "",
  "sourceUrl": "",
  "method": "post",
  "path": "/v2/tax/qys/writeTaxExcelData",
  "tags": [],
  "status": "released",
  "requestBody": {
    "type": "application/json",
    "parameters": [],
    "jsonSchema": {
      "type": "object",
      "properties": {
        "aggOrgId": {
          "type": "string",
          "title": "企业Id"
        },
        "optionCodeList": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "optionCode": {
                "type": "string",
                "title": "选项code"
              },
              "memoJson": {
                "type": "string",
                "title": "备注信息"
              },
              "fileCode": {
                "type": "string",
                "title": "文件编码",
                "description": "base64加密后的串，非必传。只有optionCode为强制申报使用"
              },
              "fileName": {
                "type": "string",
                "title": "文件名称"
              }
            },
            "x-apifox-orders": [
              "optionCode",
              "memoJson",
              "fileCode",
              "fileName"
            ],
            "required": [
              "fileName",
              "fileCode"
            ]
          },
          "title": "多条弹窗设置明细"
        },
        "year": {
          "type": "integer",
          "title": "税款所属期年"
        },
        "period": {
          "type": "integer",
          "title": "税款所属期月",
          "description": "自然月；例如：10月份申报增值税2021-09-01到2021-09-30，period传10"
        },
        "zsxmList": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "yzpzzlDm": {
                "type": "string",
                "title": "应征凭证种类代码",
                "description": "参考申报附录：yzpzzlDm应征凭证种类代码"
              },
              "ssqQ": {
                "type": "string",
                "title": "所属期起",
                "description": "格式yyyy-MM-dd"
              },
              "ssqZ": {
                "type": "string",
                "title": "所属期止",
                "description": "格式yyyy-MM-dd"
              },
              "zspmDm": {
                "type": "string",
                "title": "征收品目代码",
                "description": "文化事业建设费时必传字段，用来区分文化业还是娱乐业，302170100娱乐业文化事业建设费、302170200广告业文化事业建设费。（税报）"
              },
              "zlbsxlDm": {
                "type": "string",
                "title": "资料报送小类代码",
                "description": "财报必须传,ZL1001001:一般企业会计准则、ZL1001002企业会计制度、ZL1001003:小企业会计准则、ZL1001050企业会计准则金融企业"
              },
              "templateCode": {
                "type": "string",
                "title": "资料报送子类代码",
                "description": "【一般企业会计准则】类型时必填，1:适用未执行新金融准则、新收入准则和新租赁准则的一般企业、2:适用已执行新金融准则、新收入准则和新租赁准则的一般企业；\n【企业会计准则金融企业】类型是必填，1：适用已执行新金融工具准则的金融企业（目前仅支持金融类型的这个子类）；\n其他准则传0"
              },
              "isDirectDeclare": {
                "type": "boolean",
                "title": "是否上传后直接申报",
                "description": "默认传true，目前接口无暂存能力，只支持上传后直接申报。"
              },
              "attachEncode": {
                "type": "string",
                "title": "税表excelbase64加密后的串，必传"
              },
              "attachName": {
                "type": "string",
                "title": "税表excel文件名称 必传"
              },
              "gzDeclare": {
                "type": "integer",
                "description": "1表示覆盖申报；0表示不覆盖。默认及空为0； 当isDirectDeclare为true 时生效。",
                "title": "财报覆盖申报"
              }
            },
            "x-apifox-orders": [
              "yzpzzlDm",
              "ssqQ",
              "ssqZ",
              "zspmDm",
              "zlbsxlDm",
              "templateCode",
              "attachEncode",
              "attachName",
              "isDirectDeclare",
              "gzDeclare"
            ],
            "required": [
              "yzpzzlDm",
              "ssqQ",
              "ssqZ",
              "isDirectDeclare",
              "attachEncode",
              "attachName",
              "gzDeclare"
            ]
          },
          "title": "征收项目列表"
        },
        "usePresetDialog": {
          "type": "boolean",
          "title": "使用预置弹窗信息",
          "description": "true=使用 flase = 不使用（以当期上传弹窗为准，未上传则认定为未预置）默认true"
        },
        "kkfs": {
          "type": "integer",
          "title": "扣款方式",
          "description": "已下架参数，1：手动扣款，2：预约扣款。仅浙江、海南、云南需要，其它地区忽略该字段"
        },
        "yykkrq": {
          "type": "string",
          "title": "预约扣款日期",
          "description": "已下架参数，yyyy-MM-dd格式，如2023-12-13，仅当扣款方式(kkfs)为2时必传"
        },
        "bsswjg": {
          "type": "string",
          "title": "税务机关名称跨区域上传省市区(只针对房产税，城镇土地使用税，环保税)",
          "description": "上传格式 省|市|区 如“湖南省|湘潭市|岳塘区”"
        },
        "jrwc": {
          "type": "string",
          "title": "是否兼容一分钱尾差",
          "description": "Y兼容，N不兼容。默认不兼容。"
        },
        "sfxzyhssm": {
          "type": "boolean",
          "title": "是否新增印花税税目",
          "description": "按期申报税局未认定或者一个税目需要申报多条税源明细需要操作新增税目 (true新增/false不新增)"
        },
        "zsxmDm": {
          "type": "string",
          "title": "征收项目代码",
          "description": "工会经费=39900/水利建设专项收入=30221 合并申报则可以为空"
        },
        "accountId": {
          "type": "string",
          "title": "账号ID",
          "description": "多账号场景使用"
        },
        "tdztswjgmc": {
          "type": "string",
          "title": "特定主体税务机关名称"
        },
        "kqyswjgmc": {
          "type": "string",
          "title": "跨区域税局机关名称(只针对房产税，城镇土地使用税，环保税)",
          "description": "上传格式 如“国家税务总局鞍山高新技术产业开发区税务局税源管理一股”,正确上传值可以以企业信息-跨区域信息节点返回进行参考"
        },
        "zdsysfsh": {
          "type": "string",
          "title": "重点税源是否审核",
          "description": "1=审核 不传或者传空则是申报"
        },
        "sfjxbdjy": {
          "type": [
            "string",
            "null"
          ],
          "description": "财报专用，Y=是/N=否 ；备注：非必传字段，请求Y则会对请求的表单节点与税局报表列表进行比对是否一致，税局要求申报的表单未请求则失败返回。默认传空，或者传N则是维持现状只校验必填表单（资产、利润），其他表单不上传默认以税种申报",
          "title": "是否进行表单校验"
        },
        "disableDeclareCache": {
          "type": "string",
          "title": "禁用申报缓存",
          "description": "Y/N 非必传参数，默认为空。Y=不缓存 空/N或者不传这个参数=缓存"
        }
      },
      "x-apifox-refs": {},
      "x-apifox-orders": [
        "aggOrgId",
