{
  "id": 91708966,
  "name": "校验税局缓存是否有效",
  "type": "http",
  "serverId": "",
  "preProcessors": [],
  "postProcessors": [],
  "inheritPreProcessors": {},
  "inheritPostProcessors": {},
  "description": "##  接口描述\n\n该接口用于36个地区的异步登录成功后，缓存的dppt cookie是否有效。\n   支持加密参见：[加密说明](doc-3774763)",
  "operationId": "",
  "sourceUrl": "",
  "method": "post",
  "path": "/v2/public/login/ext/checkAsyncLoginSjCache",
  "tags": [],
  "status": 1,
  "requestBody": {
    "type": "application/json",
    "parameters": [],
    "jsonSchema": {
      "type": "object",
      "properties": {
        "nsrsbh": {
          "type": "string",
          "title": "纳税人识别号",
          "description": "该值必填"
        },
        "areaCode": {
          "type": "string",
          "title": "地区编码",
          "description": "四川传值5100，青岛为3702。该值必填"
        },
        "gryhm": {
          "type": "string",
          "title": "用户名",
          "description": "可为：居民身份证/手机号/用户名。该值必填"
        },
        "gryhmm": {
          "type": "string",
          "title": "个人用户密码",
          "description": "该值必填，当encryptionType=1时该值必须加密"
        },
        "sflx": {
          "type": "string",
          "title": "身份类型",
          "description": "参见附录身份类型，和登录传的sflx要保持一致"
        },
        "sjhm": {
          "type": "string",
          "title": "手机号码",
          "description": "除广东、天津、浙江、湖北外，该值必填"
        },
        "encryptionType": {
          "type": "string",
          "description": " 1表示加密,默认0不加密",
          "title": "加密类型"
        },
        "isOnlyCheckCache": {
          "type": "integer",
          "title": "只检查缓存",
          "description": "1表示只检查缓存不再尝试登录"
        }
      },
      "x-apifox-orders": [
        "encryptionType",
        "nsrsbh",
        "areaCode",
        "gryhm",
        "gryhmm",
        "sflx",
        "sjhm",
        "isOnlyCheckCache"
      ],
      "required": [
        "encryptionType",
        "nsrsbh",
        "areaCode",
        "gryhm",
        "gryhmm",
        "sflx",
        "sjhm"
      ]
    },
