\r\nconst hour = shDate.getHours().toString().padStart(2, '0');\r\nconst minute = shDate.getMinutes().toString().padStart(2, '0');\r\nconst second = shDate.getSeconds().toString().padStart(2, '0');\r\nvar kprq = `${year}-${month}-${day} ${hour}:${minute}:${second}`;\r\nresponseJson.lrrq = kprq;\r\nresponseJson.lzFphm = lzFphm;\r\n\r\nresponseJson.hzfpxx.kprq = kprq;\r\nresponseJson.hzfpxx.fphm = fphm;\r\nresponseJson.hzfpxx.kplsh = kplsh;\r\nif(fplxdm !== null && fplxdm !== undefined && fplxdm !== \"\"){\r\n    responseJson.hzfpxx.fplxdm = fplxdm;\r\n}\r\n\r\n// 将修改后的 json 写入 $$.mockResponse\r\n$$.mockResponse.setBody(responseJson);"
