{
  "id": 487256885,
  "name": "局端忘记密码发送短信",
  "type": "http",
  "serverId": "",
  "preProcessors": [],
  "postProcessors": [],
  "inheritPreProcessors": {},
  "inheritPostProcessors": {},
  "description": "如果是企享云购买的小号，调用此接口直接完成密码修改，不需要上传短信\n如果不是小号，调用此接口则会完成发送短信\n托管账号修改完局端密码后还需要维护账号关系，调用账号管理-账号修改接口",
  "operationId": "",
  "sourceUrl": "",
  "method": "post",
  "path": "/v2/public/login/forgetPassw/sendSms",
  "tags": [],
  "status": "released",
  "requestBody": {
    "type": "application/json",
    "parameters": [],
    "jsonSchema": {
      "type": "object",
      "properties": {
        "dq": {
          "type": "string",
          "title": "地区",
          "description": "见附录"
        },
        "zjlx": {
          "type": "string",
          "title": "证件类型代码",
          "description": "目前仅支持201-身份证 默认值201"
        },
        "zjhm": {
          "type": "string",
          "title": "证件号码",
          "description": "目前仅支持身份证号"
        },
        "gryhmm": {
          "type": "string",
          "title": "个人用户名密码",
          "description": "新密码使用RSA加密\n校验规则：长度为8-16个字符，必须包含数字、字母（区分大小写）、特殊字符（包括 . @ $ %* # _ + - ~ & ^ ）三者中至少两种"
        },
        "sjhm": {
          "type": "string",
          "title": "手机号码",
          "description": "用户接受短信验证"
        },
        "nsrsbh": {
          "type": "string",
          "title": "税号"
        }
      },
      "x-apifox-orders": [
        "dq",
        "zjlx",
        "zjhm",
        "sjhm",
        "gryhmm",
        "nsrsbh"
      ],
      "required": [
        "dq",
        "zjhm",
        "gryhmm",
        "sjhm",
        "nsrsbh"
      ]
    },
    "required": true,
    "mediaType": "",
