    "parameters": [],
    "jsonSchema": {
      "type": "object",
      "properties": {
        "nsrsbh": {
          "type": "string",
          "title": "纳税人识别号",
          "description": "该值必填"
        },
        "accountId": {
          "type": "string",
          "title": "账户ID",
          "description": "客户提供唯一md5；\n使用账密加验证码登录方式，生成规则MD5(\"个人用户名\"+\"[a%b@q]\"+\"手机号\"+\"[a%b@q]\"+\"身份类型名称\")；\n示例：MD5(\"12345674321[a%b@q]12345674321[a%b@q]开票员\")"
        },
        "areaCode": {
          "type": "string",
          "title": "地区编码",
          "description": "四川传值5100，青岛为3702。该值必填"
        },
        "cookie": {
          "type": "string",
          "title": "cookie值"
        }
      },
      "x-apifox-orders": [
        "nsrsbh",
        "accountId",
        "areaCode",
        "cookie"
      ],
