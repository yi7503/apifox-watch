{
  "id": 69611258,
  "name": "发起申报任务",
  "type": "http",
  "serverId": "",
  "preProcessors": [],
  "postProcessors": [],
  "inheritPreProcessors": {},
  "inheritPostProcessors": {},
  "description": "## 接口即将废弃\n请用上传税报表数据以及上传财报报表数据这2个接口中isDirectDeclare=true直接发起申报\n## 接口描述\n根据税费种明细和税款所属期发起已经确认过数据的税费种申报任务。不再维护\n## 错误码\n| **错误代码** | **错误信息**  | **解决方案**|\n| --- | --- |---|\n|PARAMETER_ERROR|企业Id(aggOrgId)不能为空！|\n|PARAMETER_ERROR   | 请求参数year或period不能为空！   |\n|PARAMETER_ERROR|请求参数year或period不合法！|\n|PARAMETER_ERROR |参数yzpzzlDms和zsxmList不能都为空！ |\n| PARAMETER_ERROR|参数yzpzzlDms和zsxmList不能都存在！ |\n|PARAMETER_ERROR |应征凭证种类代码为BDA0611033的企业所得税A类（2018年版）（查账征收）已停用，<br>请改用应征凭证种类代码BDA0611159来标志企业所得税A类（2021年版A类）（查账征收) |\n| BUSINESS_ERROR|预约扣款情况，预约扣款日期必填并且是yyyy-MM-dd格式，当前错误值：XXX |",
  "operationId": "",
  "sourceUrl": "",
  "method": "post",
  "path": "/v2/tax/qys/loadDeclareTask",
  "tags": [],
  "status": 0,
  "requestBody": {
    "type": "application/json",
    "parameters": [],
    "jsonSchema": {
      "title": "税局取数入参",
      "type": "object",
      "properties": {
        "aggOrgId": {
          "type": "string",
          "title": "企业Id"
        },
        "year": {
          "type": "integer",
          "title": "年"
        },
        "period": {
          "type": "integer",
          "title": "申报月份，自然月",
          "description": "例如：10月份申报增值税2021-09-01到2021-09-30，period传10"
        },
        "zsxmList": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "yzpzzlDm": {
                "type": "string",
                "title": "应征凭证种类代码",
                "description": "参考附录yzpzzlDm应征凭证种类代码"
              },
              "ssqQ": {
                "type": "string",
                "title": "所属期起",
                "description": "格式yyyy-MM-dd"
              },
              "ssqZ": {
                "type": "string",
                "title": "所属期止",
                "description": "格式yyyy-MM-dd"
              },
              "zspmDm": {
                "type": [
                  "string",
                  "null"
                ],
                "title": "征收品目代码",
                "description": "文化事业建设费时必传字段，用来区分文化业还是娱乐业",
                "enum": [
                  "302170100",
                  "302170200"
                ],
                "x-apifox-enum": [
                  {
                    "name": "",
                    "value": "302170100",
                    "description": "娱乐业文化事业建设费"
                  },
                  {
                    "name": "",
                    "value": "302170200",
                    "description": "广告业文化事业建设费"
                  }
                ]
              },
              "zlbsxlDm": {
                "type": [
                  "string",
                  "null"
                ],
                "title": "资料报送小类代码",
                "description": "财报必须传，ZL1001001:一般企业会计准则、ZL1001003:小企业会计准则",
                "enum": [
                  "ZL1001001",
                  "ZL1001003"
                ],
                "x-apifox-enum": [
                  {
                    "name": "",
                    "value": "ZL1001001",
                    "description": "一般企业会计准则"
                  },
                  {
                    "name": "",
                    "value": "ZL1001003",
                    "description": "小企业会计准则"
                  }
                ]
              },
              "templateCode": {
                "type": [
                  "string",
                  "null"
                ],
                "title": "资料报送子类代码",
                "description": "【一般企业会计准则】类型时必填，1:适用未执行新金融准则、新收入准则和新租赁准则的一般企业、2:适用已执行新金融准则、新收入准则和新租赁准则的一般企业"
              },
              "zeroDeclare": {
                "type": "integer",
                "title": "发起全零申报标记",
                "description": "即将下架参数，新版税局无此功能 （按照税局一键零申报逻辑） 0非全零申报，1全零申报；默认0非全零申报"
              },
              "zsxmDm": {
                "type": "string",
                "title": "征收项目代码",
                "description": "工会经费=39900/水利建设专项收入=30221 合并申报则可以为空"
              }
            },
            "x-apifox-orders": [
              "yzpzzlDm",
              "ssqQ",
              "ssqZ",
              "zspmDm",
              "zlbsxlDm",
              "templateCode",
              "zeroDeclare",
              "zsxmDm"
            ],
            "required": [
              "yzpzzlDm",
              "ssqQ",
              "ssqZ"
            ]
          },
          "title": "税种明细列表"
        },
        "waitResult": {
          "type": "boolean",
          "description": "即将下架参数，新版税局无此功能  是否等待结果（仅针对浙江、云南、海南地区）",
          "title": "是否等待结果"
        },
        "gzDeclare": {
          "type": "integer",
          "title": "财报覆盖申报",
          "description": "1表示覆盖申报；0表示不覆盖。默认及空为0；当yzpzzlDm为CWBBSB时生效。此参数针对税局财报已申报，是否继续覆盖申报，仅北京、广东地区支持，其余地区陆续上线中"
        },
        "kkfs": {
          "type": "integer",
          "title": "扣款方式",
          "description": "即将下架参数，新版税局无此功能 1：手动扣款，2：预约扣款。仅浙江、海南、云南需要，其它地区忽略该字段"
        },
        "yykkrq": {
          "type": "string",
          "title": "预约扣款日期",
          "description": "即将下架参数，新版税局无此功能  yyyy-MM-dd格式，如2023-12-13，仅当扣款方式(kkfs)为2时必传"
        },
        "jrwc": {
          "type": "string",
          "title": "是否兼容一分钱尾差",
          "description": "Y兼容，N不兼容。默认不兼容。"
        },
        "accountId": {
          "type": "string",
          "title": "账号Id",
          "description": "多账号ID"
        },
        "zdsysfsh": {
          "type": "string",
          "title": "重点税源是否审核",
          "description": "1=审核 不传或者传空则是申报"
        }
      },
      "x-apifox-refs": {},
      "x-apifox-orders": [
        "aggOrgId",
        "accountId",
        "year",
        "period",
        "kkfs",
        "yykkrq",
        "jrwc",
        "zdsysfsh",
        "waitResult",
        "gzDeclare",
        "zsxmList"
      ],
      "required": [
        "aggOrgId",
        "year",
        "period",
        "zsxmList"
      ]
    },
    "examples": [
      {
