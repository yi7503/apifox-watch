                  "title": "开票起始日期",
                  "description": "yyyy-MM-dd；红字申请表申请日期；起止日期必传且为三个月内（考虑局端压力平台做了限制）"
                },
                "kprqz": {
                  "type": "string",
                  "title": "开票结束日期",
                  "description": "yyyy-MM-dd；红字申请表申请日期；起止日期必传且为三个月内（考虑局端压力平台做了限制）"
                },
                "gxflx": {
                  "type": "string",
                  "title": "购销方类型",
                  "description": "0：我是销方，1：我是购方，2：我是二手车市场",
                  "enum": [
                    "0",
                    "1",
                    "2"
