              "ssqQ": {
                "type": "string",
                "description": "格式为yyyy-MM-dd；所属起止和缴款日期起止必须有一类请求",
                "title": "所属期起"
              },
              "ssqZ": {
                "type": "string",
                "description": "格式为yyyy-MM-dd；所属起止和缴款日期起止必须有一类请求",
                "title": "所属期止"
              },
              "yzpzzlDm": {
                "type": "string",
                "title": "应征凭证种类代码",
                "description": "参考申报附录应征凭证种类代码"
              },
              "zspmDm": {
                "type": "string",
                "description": "文化事业建设费时，征收品目代码为必传项",
                "title": "征收品目代码"
              },
              "zsxmDm": {
                "type": "string",
                "description": "工会经费=39900/水利建设专项收入=30221 合并下载则可以为空",
                "title": "征收项目代码"
              },
              "bsswjg": {
                "type": "string",
                "title": "跨区域上传税务机关名称",
                "description": "（上传格式 省|市|区 如“湖南省|湘潭市|岳塘区”）"
              },
              "kqyswjgmc": {
                "type": "string",
                "title": "跨区域税局机关名称",
                "description": "税局账户中心-跨区域切换中的税务机关名称"
              },
              "jkrqq": {
                "type": "string",
                "title": "缴款日期起",
                "description": "格式为yyyy-MM-dd  缴款日期起止不能跨年；所属起止和缴款日期起止必须有一类请求"
              },
              "jkrqz": {
                "type": "string",
                "title": "缴款日期止",
                "description": "格式为yyyy-MM-dd  缴款日期起止不能跨年；所属起止和缴款日期起止必须有一类请求"
              }
            },
