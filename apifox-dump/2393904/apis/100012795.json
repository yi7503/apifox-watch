          "type": "string",
          "title": "执行状态",
          "description": "固定为720007",
          "const": "720007"
        },
        "returnMsg": {
          "type": "string",
          "title": "业务返回消息",
          "examples": [
            "服务商可在此基础上生成二维码获取链接并推送短信、公众号消息通知开票人员进行扫脸认证。"
          ],
          "description": "通常的消息为：请重新扫脸、扫脸认证已过期等。"
        },
        "request": {
