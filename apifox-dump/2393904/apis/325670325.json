    "parameters": [],
    "jsonSchema": {
      "type": "object",
      "properties": {
        "aggOrgId": {
          "type": "string",
          "maxLength": 64,
          "title": "企业ID",
          "description": "维护企业信息接口返回的aggOrgId"
        },
        "accountId": {
          "type": "string",
          "maxLength": 64,
          "title": "账户ID",
          "description": "传入accountId就免传登录信息"
        },
        "skssq": {
          "type": "string",
          "maxLength": 64,
          "title": "所属期",
          "description": "格式YYYYMM年月",
          "pattern": "^\\d{6}$"
        },
        "gschlb": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "xm": {
                "type": "string",
                "maxLength": 64,
                "title": "姓名"
              },
              "zzlx": {
                "type": "string",
                "maxLength": 64,
                "title": "证件类型"
              },
              "zzhm": {
                "type": "string",
                "maxLength": 64,
                "title": "证件号码"
              },
              "sre": {
                "type": "number",
                "title": "本期收入额"
              },
              "mssd": {
                "type": "number",
                "title": "免税收入",
                "default": 0,
                "description": "无则填0（填写数不得大于当期收入额）"
              },
              "jbylaobxf": {
                "type": "number",
                "title": "基本养老保险",
                "default": 0
              },
              "jbylbxf": {
                "type": "number",
                "title": "基本医疗保险",
                "default": 0
              },
              "sybxf": {
                "type": "number",
                "title": "失业保险",
                "default": 0
              },
              "zfgjj": {
                "type": "number",
                "title": "住房公积金",
                "default": 0
              },
              "nj": {
                "type": "number",
                "title": "年金",
                "default": 0
              },
              "syjkbx": {
                "type": "number",
                "title": "商业健康保险",
                "default": 0
              },
              "syylbx": {
                "type": "number",
                "title": "税延养老保险",
                "default": 0
              },
              "qt": {
                "type": "number",
                "title": "其他",
                "default": 0
              },
              "zykfjze": {
                "type": "number",
                "title": "准予扣除的捐赠额",
                "default": 0,
                "description": "按照税法以及相关法规、政策规定，可以在税前扣除的捐赠额"
              },
              "jmse": {
                "type": "number",
                "title": "减免税额",
                "default": 0
              },
              "ljsre": {
                "type": "number",
                "title": "预计全年累计收入额",
                "description": "不包含全年一次性奖金"
              },
              "qnycxjjsre": {
                "type": "number",
                "title": "全年一次性奖金收入额"
              },
              "ljmssd": {
                "type": "number",
                "title": "预计全年累计免税收入",
                "default": 0
              },
              "ljzxkce": {
                "type": "number",
                "title": "预计全年累计专项扣除",
                "default": 0
              },
              "ljqtkce": {
                "type": "number",
                "title": "预计全年累计其他扣除",
                "default": 0
              },
              "ljzykcjze": {
                "type": "number",
                "title": "预计全年累计准予扣除的捐赠额",
                "default": 0
              },
              "ljjmse": {
                "type": "number",
                "title": "预计全年累计减免税额",
                "default": 0
              }
            },
