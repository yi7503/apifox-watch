{
  "id": 397381029,
  "name": "校验税局缓存是否有效多合一",
  "type": "http",
  "serverId": "",
  "preProcessors": [],
  "postProcessors": [],
  "inheritPreProcessors": {},
  "inheritPostProcessors": {},
  "description": "##  接口描述\n\n自持模式下检验缓存是否有效\n支持多账号，单账号，支持企业和代理登录",
  "operationId": "",
  "sourceUrl": "",
  "method": "post",
  "path": "/v2/public/login/zc/checkCache",
  "tags": [
    "登录"
  ],
  "status": -1,
  "requestBody": {
    "type": "application/json",
    "parameters": [],
    "jsonSchema": {
      "type": "object",
      "properties": {
        "nsrsbh": {
          "type": "string",
          "title": "纳税人识别号",
          "description": "，该值必填"
        },
        "areaCode": {
          "type": "string",
          "title": "地区编码",
          "description": "四川传值5100，青岛为3702。该值必填"
        },
        "gryhm": {
          "type": "string",
          "title": "用户名",
          "description": "可为：居民身份证/手机号/用户名。该值必填"
        },
        "gryhmm": {
          "type": "string",
          "title": "个人用户密码",
          "description": "该值必填，当encryptionType=1时该值必须加密"
        },
        "sflx": {
          "type": "string",
          "title": "身份类型",
          "description": "参见附录身份类型"
        },
        "sjhm": {
          "type": "string",
          "title": "手机号码",
          "description": "除广东、天津、浙江、湖北外，该值必填"
        },
        "encryptionType": {
          "type": "string",
          "description": " 1表示加密,默认0不加密",
          "title": "加密类型"
        },
        "proxyNsrsbh": {
          "type": "string",
          "title": "代理机构税号，如果是代理企业该字段必传",
          "description": "如果是代理机构的是必传"
        },
        "accountId": {
          "type": "string",
          "title": "如果是多账号是必传"
        },
        "isOnlyCheckCache": {
          "type": "integer",
          "title": "是否只校验缓存接口",
          "description": "1 只校验缓存 0 校验缓存并且切换"
        }
      },
      "x-apifox-orders": [
        "encryptionType",
        "nsrsbh",
        "areaCode",
        "gryhm",
        "gryhmm",
        "sflx",
        "sjhm",
        "accountId",
        "proxyNsrsbh",
        "isOnlyCheckCache"
      ],
      "required": [
        "nsrsbh",
        "areaCode",
        "sflx",
        "gryhm"
      ]
    },
    "mediaType": "",
    "examples": [
      {
        "value": "//方式一：传参为指定登录信息\r\n{\r\n    \"nsrsbh\": \"9151xxxxxxxxxxxxxx\",\r\n    \"areaCode\": \"5100\",\r\n    \"gryhm\": \"131xxxxxxxx\",\r\n    \"grymm\": \"xxxxxx\",\r\n    \"sflx\": \"BSY\",\r\n    \"sjhm\": \"131xxxxxxxx\"\r\n}",
        "mediaType": "application/json",
        "description": "",
        "name": "单账号"
      },
      {
        "name": "多账号(代理企业)",
        "value": "{\r\n    \"accountId\": \"6a7efeba04f11e7656098deegegeg\",\r\n    \"nsrsbh\": \"123214XXXXXXXXXX\",\r\n    \"proxyNsrsbh\": \"9123242XXXXXXXXXX\",\r\n    \"areaCode\": \"3100\",\r\n    \"sflx\": \"BSFWRY\"\r\n}",
        "mediaType": "application/json"
      }
    ],
    "oasExtensions": ""
  },
