          "type": "string",
          "title": "企业id"
        },
        "accountId": {
          "type": "string",
          "title": "账号id"
        },
        "kcnd": {
          "type": "string",
          "title": "扣除年度"
        },
        "rylb": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "xm": {
                "type": "string",
                "title": "姓名"
              },
              "zzhm": {
                "type": "string",
                "title": "证照号码"
              },
              "jzpzh": {
                "type": "string",
                "title": "捐赠凭证号"
              },
              "sfyqdjzpz": {
                "type": "string",
                "title": "是否已取得捐赠凭证"
              },
              "kcbl": {
                "type": "number",
                "title": "扣除比例",
                "description": "可填：0.3 或 1"
              },
              "jzje": {
                "type": "number",
                "title": "捐赠金额",
                "description": "大于＞0且保留两位小数"
              },
              "pjkjlx": {
                "type": "string",
                "title": "票据开具类型",
                "description": "可填：汇总票据 或 单人票据"
              },
              "jzrq": {
                "type": "string",
                "title": "捐赠日期"
              },
              "jzlx": {
                "type": "string",
                "title": "捐赠类型",
                "description": "可填：向红十字事业的捐赠；向福利性、非营利性的老年服务；向农村义务教育的捐赠；向教育事业的捐赠；捐赠住房作为公租房；其他公益救济性的捐赠"
              },
              "zzlx": {
                "type": "string",
                "title": "证件类型"
              },
              "zmcl": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "wjmc": {
                      "type": "string",
                      "title": "文件名称",
                      "description": "需带上文件的扩展名，如：xxx.pdf、xxx.png等"
                    },
                    "wjurl": {
                      "type": "string",
                      "title": "文件URL",
                      "description": "证明材料的文件上传的url（文件上传参考 [文件上传](apifox://link/pages/8334504) ）"
                    }
                  },
                  "x-apifox-orders": [
                    "wjmc",
                    "wjurl"
                  ],
                  "required": [
                    "wjmc",
                    "wjurl"
                  ]
                },
                "title": "证明材料列表",
                "description": "上传捐赠票据等证明材料，最多可上传10个文件，单个文件大小不超过4M，支持BMP、PNG、JPG、JPEG、PDF格式。"
              },
              "szdwtyshxydm": {
                "type": [
                  "string",
                  "null"
                ],
                "title": "受赠单位统一社会信用代码"
              }
            },
            "x-apifox-orders": [
