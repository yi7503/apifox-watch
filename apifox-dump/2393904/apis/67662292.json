{
  "id": 67662292,
  "name": "发起税款缴纳任务",
  "type": "http",
  "serverId": "",
  "preProcessors": [],
  "postProcessors": [],
  "inheritPreProcessors": {},
  "inheritPostProcessors": {},
  "description": "## 接口描述\n   该接口用于批量发起税款缴纳任务。\n\n## 错误码\n| **错误代码** | **错误信息**  | **解决方案**|\n| --- | --- |---|\n|PARAMETER_ERROR|企业Id(aggOrgId)不能为空！|\n|PARAMETER_ERROR   | 请求参数year或period不能为空！   |\n|PARAMETER_ERROR|请求参数year或period不合法！ |\n|PARAMETER_ERROR |应征凭证种类代码为BDA0611033的企业所得税A类（2018年版）（查账征收）已停用，<br>请改用应征凭证种类代码BDA0611159来标志企业所得税A类（2021年版A类）（查账征收) |",
  "operationId": "",
  "sourceUrl": "",
  "method": "post",
  "path": "/v2/tax/qys/loadPaymentTask",
  "tags": [],
  "status": "released",
  "requestBody": {
    "type": "application/json",
    "parameters": [],
    "jsonSchema": {
      "type": "object",
      "properties": {
        "aggOrgId": {
          "type": "string",
          "description": "企业id"
        },
        "year": {
          "type": "integer",
          "description": "年"
        },
        "period": {
          "type": "integer",
          "description": "月"
        },
        "detail": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "yzpzzlDm": {
                "type": "string",
                "description": "应征凭证种类代码"
              },
              "fromDate": {
                "type": "string",
                "description": "有效期起"
              },
              "toDate": {
                "type": "string",
                "description": "有效期止"
              },
              "taxAmount": {
                "type": "number",
                "description": "申请缴款金额",
                "format": "double"
              },
              "agreementAccount": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "三方缴款协议号"
              },
              "zspmDm": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "文化事业建设费为区分税种明细，需要传参征收品目代码（zspmDm）302170100代表娱乐业文化事业建设费或302170200代表广告业文化事业建设费"
              },
              "yhzh": {
                "type": "string",
                "description": "银行账号 （银行账号缴款用的到，不传税局默认选择付款信息为空）"
              },
              "jkfs": {
                "type": "string",
                "description": "缴款方式 0-三方协议号缴款 1 银行账号缴款 2-二维码缴款;不传则默认三方协议缴款"
              },
              "zsxmDm": {
                "type": "string",
                "description": "征收项目代码工会经费=39900/水利建设专项收入=30221 合并缴款则可以为空"
              },
              "bsswjg": {
                "type": "string",
                "description": "跨区域缴款(只针对房产税，城镇土地使用税，环保税)上传办税税务机关上传格式 省|市|区 如“湖南省|湘潭市|岳塘区”"
              },
              "sebyz": {
                "type": "string",
                "description": "请求税额大于税局税额5元以内，税额不一致允许缴款，（Y是/N否 （仅针对部分区域财行税按照税目判断小于1元不需要缴款）默认=N否）"
              },
              "kqyswjgmc": {
                "type": "string",
                "description": "跨区域税局机关名称"
              }
            },
            "x-apifox-orders": [
              "yzpzzlDm",
              "fromDate",
              "toDate",
              "taxAmount",
              "agreementAccount",
              "zspmDm",
              "jkfs",
              "yhzh",
              "zsxmDm",
              "bsswjg",
              "kqyswjgmc",
              "sebyz"
            ],
            "required": [
              "yzpzzlDm",
              "fromDate",
              "toDate",
              "taxAmount"
            ]
          },
          "description": "税种明细列表"
        },
        "duration": {
          "type": [
            "integer",
            "null"
          ],
          "description": "任务时长（必须大于30），单位分钟"
        },
        "accountId": {
          "type": "string",
          "description": "账号ID（多账号场景使用）"
        },
        "tdztswjgmc": {
          "type": "string",
          "description": "特定主体税务机关名称"
        },
        "disableDeclareCache": {
          "type": "string",
          "title": "禁用申报缓存",
          "description": "Y/N 非必传参数，默认为空。Y=不缓存  空/N或者不传这个参数=缓存"
        }
      },
      "required": [
        "aggOrgId",
        "year",
        "period",
        "detail"
      ],
      "x-apifox-orders": [
        "aggOrgId",
        "accountId",
        "tdztswjgmc",
        "year",
        "period",
        "duration",
        "disableDeclareCache",
        "detail"
      ]
    },
    "required": false,
    "mediaType": "",
    "examples": [
