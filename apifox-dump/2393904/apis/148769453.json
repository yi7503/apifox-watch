          "title": "地区编码",
          "description": "地区编码（二位或四位地区编码）"
        },
        "cjyfq": {
          "type": "string",
          "title": "采集月份起",
          "description": "格式：yyyyMM，\nsb节点可以通过bbcjrqlx字段选择按申报日期或所属期采集；\njcxx节点-申报查询 按申报日期采集；\njcxx节点-税款征收信息 按缴款日期采集；\n其他节点数据默认按所属期采集；\n"
        },
        "cjyfz": {
          "type": "string",
          "title": "采集月份止",
          "description": "格式：yyyyMM，\nsb节点可以通过bbcjrqlx字段选择按申报日期或所属期采集；\njcxx节点-申报查询 按申报日期采集；\njcxx节点-税款征收信息 按缴款日期采集；\n其他节点数据默认按所属期采集；\n"
        },
        "updateCache": {
          "type": [
            "string",
            "null"
          ],
          "title": "更新缓存",
          "description": "更新缓存数据（默认0：不更新，1：更新）"
        },
