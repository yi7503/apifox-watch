        },
        "tdztswjgmc": {
          "type": "string",
          "title": "特定主体税务机关名称",
          "description": "1. 特定主体采集专用；\n2. 跨区域业务和特定主体业务需要分开采集不能同时有值；\n3. tdztswjgmc有值的时候accountId必须有值；"
        },
