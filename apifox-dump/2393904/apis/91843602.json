{
  "id": 91843602,
  "name": "小号短信通知回调",
  "type": "http",
  "serverId": "",
  "preProcessors": [],
  "postProcessors": [],
  "inheritPreProcessors": {},
  "inheritPostProcessors": {},
  "description": "## 前提条件\n1、客户添加应用时需设置短信通知接收地址，并确保提供的地址能够正常处理平台发送的通知消息。如果需要开启短信通知功能，请通过配置短信通知地址配置短信接受地址。\n\n## 接口描述\n此接口向客户推送办税小号的短信通知。 客户收到通知后返回HTTP状态码为200的空消息即可。\n\n## 返回结果\n客户服务器接收到短信事件通知后，返回无消息体的200响应\n\n## 响应示例：\nHTTP/1.1 200 OK",
  "operationId": "",
  "sourceUrl": "",
  "method": "post",
  "path": "/客户提供的小号短信通知地址",
  "tags": [],
  "status": 1,
  "requestBody": {
    "type": "application/json",
    "parameters": [],
    "jsonSchema": {
      "type": "object",
      "properties": {
        "callId": {
          "type": "string",
          "title": "短信唯一标识"
        },
        "sender": {
          "type": "string",
          "title": "短信的发送人",
          "description": "一般指当地税局的号码，例如：10690510000000562537"
        },
        "receiver": {
          "type": "string",
          "title": "短信的接收人，即办税小号"
        },
        "smsContent": {
          "type": "string",
          "title": "短信内容"
        },
        "receiveTime": {
          "type": "string",
          "title": "短信收到的时间",
          "description": "格式为yyyy-MM-dd HH:mm:ss"
        },
        "pushTime": {
          "type": "string",
          "title": "短信推送给客户的时间",
          "description": "格式为yyyy-MM-dd HH:mm:ss"
        }
      },
      "x-apifox-orders": [
        "callId",
        "sender",
        "receiver",
        "smsContent",
        "receiveTime",
        "pushTime"
      ],
      "required": [
