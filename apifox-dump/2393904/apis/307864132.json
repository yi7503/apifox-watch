            },
            "sxedlstzlx": {
              "type": "string",
              "title": "发票额度短期调整类型",
              "description": "只有申请调整额度类型位短期时，该参数生效 {\"1\": \"当月\", \"2\": \"指定期间\"}",
              "x-apifox-enum": [
                {
