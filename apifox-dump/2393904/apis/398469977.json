  "inheritPreProcessors": {},
  "inheritPostProcessors": {},
  "description": "托管账号修改\n敏感信息支持加密，加密方案参见：[加密说明](doc-3774763)",
  "operationId": "",
  "sourceUrl": "",
  "method": "post",
  "path": "/v2/public/account/update",
  "tags": [],
  "status": 1,
  "requestBody": {
    "type": "application/json",
    "parameters": [],
    "jsonSchema": {
      "type": "object",
      "properties": {
        "accountId": {
          "type": "integer",
          "title": "账户ID"
        },
        "gryhm": {
          "type": "string",
          "title": "个人用户名",
          "description": "dlfs=9时需传办税小号；dlfs=14或15时，可为身份证号/手机号码/用户名，建议统一用手机号码；"
        },
        "dlmm": {
          "type": "string",
          "title": "登录密码",
          "deprecated": true
        },
        "gryhmm": {
          "type": "string",
          "title": "个人用户密码",
          "description": "需RSA加密，[加密说明](apifox://link/pages/3774763)RSA加密"
        },
        "dlzh": {
          "type": "string",
          "title": "登录账户",
          "deprecated": true
        },
        "sjhm": {
          "type": "string",
          "title": "手机号码",
          "description": "dlfs=9时需传办税小号"
        },
        "dlfs": {
          "type": "integer",
          "title": "登录方式",
          "enum": [
            9,
            14,
            15
          ],
          "x-apifox-enum": [
            {
              "value": 9,
              "name": "企业业务登录",
              "description": "需使用办税小号"
            },
            {
              "value": 14,
              "name": "企业业务登录",
              "description": "自传验证码"
            },
            {
              "value": 15,
              "name": "代理业务登录",
              "description": "办税小号或自传验证码"
            }
          ]
        },
        "sflx": {
          "type": "string",
          "title": "身份类型",
          "description": "见附录：[身份类型](apifox://link/pages/4553802)"
        },
        "aggOrgId": {
          "type": "integer",
          "title": "企业id"
        },
        "dq": {
          "type": "integer",
          "title": "地区",
          "description": "见附录：[地区代码](apifox://link/pages/2246773)"
        }
      },
      "required": [
        "accountId",
        "aggOrgId",
        "dlfs"
      ],
      "x-apifox-orders": [
        "aggOrgId",
        "accountId",
        "dq",
        "dlfs",
        "sflx",
        "gryhm",
        "gryhmm",
