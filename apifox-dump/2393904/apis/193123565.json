{
  "id": 193123565,
  "name": "异步任务执行结果回调",
  "type": "http",
  "serverId": "",
  "preProcessors": [],
  "postProcessors": [],
  "inheritPreProcessors": {},
  "inheritPostProcessors": {},
  "description": "异步任务执行完成后，将任务执行结果通知到ISV；\n支持回调的接口：进销项发票归集-异步、已勾选发票归集-异步；\n调用方式：HTTP POST；\n报文格式：application、json、utf-8；\n接口流程：\n1、ISV根据接口形式进行开发；\n2、开发完成后，将接口访问地址提供给到企享云进行配置；\n3、任务执行完成后，企享云会将「请求任务id、任务执行结果、失败原因」通过回调地址返回；",
  "operationId": "",
  "sourceUrl": "",
  "method": "post",
  "path": "/服务商CallbackURL地址",
  "tags": [],
  "status": "released",
  "requestBody": {
    "type": "application/json",
    "parameters": [],
    "jsonSchema": {
      "type": "object",
      "properties": {
        "taskId": {
          "type": "string",
          "title": "任务id",
          "description": "定位一个任务的唯一值，不能重复"
        },
        "status": {
          "type": "integer",
          "title": "任务执行结果",
          "description": "0：初始化； 1：执行中；2 ：失败；3：成功"
        },
        "errorMsg": {
          "type": "string",
          "title": "失败原因",
          "description": "失败原因"
        },
        "result": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object",
            "properties": {
              "kpyf": {
                "type": "integer",
                "title": "开票月份"
              },
              "msg": {
                "type": "string",
                "title": "任务失败原因"
              },
              "nsrsbh": {
                "type": "string",
                "title": "纳税人识别号"
              },
              "fplx": {
                "type": "string",
                "title": "发票类型编码"
              },
              "errorCode": {
                "type": "string",
                "title": "任务失败编码",
                "description": "2000表示成功"
              },
              "jxxbz": {
                "type": "string",
                "title": "进销项标志",
                "description": "jx表示进项 xx表示销项"
              },
              "status": {
                "type": "string",
                "title": "任务状态",
                "description": "任务状态(processed 完成 processing处理中 failed 失败)"
              }
            },
            "x-apifox-orders": [
              "kpyf",
